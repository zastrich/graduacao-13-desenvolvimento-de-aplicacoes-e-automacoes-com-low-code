      "obrigatorios": [],
      "exemplo": { "pollTimes": { "item": [{ "mode": "everyMinute" }] } },
      "precisaCredencial": true
    },
    {
      "type": "n8n-nodes-base.telegramTrigger",
      "displayName": "Telegram Trigger",
      "categoria": "gatilho",
      "descricao": "Dispara o fluxo ao receber uma mensagem no bot do Telegram.",
      "obrigatorios": ["updates"],
      "exemplo": { "updates": ["message"] },
      "precisaCredencial": true
    },
    {
      "type": "n8n-nodes-base.httpRequest",
      "displayName": "HTTP Request",
      "categoria": "acao",
      "descricao": "Faz requisições HTTP a APIs externas (GET, POST, etc.).",
