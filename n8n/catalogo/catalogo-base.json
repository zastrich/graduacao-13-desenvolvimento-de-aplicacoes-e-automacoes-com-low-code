{
  "descricao": "Whitelist curada de nós que a LLM pode usar ao gerar workflows. O typeVersion real é preenchido por scripts/n8n/extrair-catalogo.ts (gera catalogo-nos.json).",
  "nos": [
    {
      "type": "n8n-nodes-base.manualTrigger",
      "displayName": "Manual Trigger",
      "categoria": "gatilho",
      "descricao": "Inicia o fluxo manualmente ao clicar em Executar. Útil para testes.",
      "obrigatorios": [],
      "exemplo": {},
      "precisaCredencial": false
    },
    {
      "type": "n8n-nodes-base.scheduleTrigger",
      "displayName": "Schedule Trigger",
      "categoria": "gatilho",
      "descricao": "Dispara o fluxo em intervalos de tempo (cron/intervalo).",
      "obrigatorios": ["rule"],
      "exemplo": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 1 }] } },
      "precisaCredencial": false
    },
    {
      "type": "n8n-nodes-base.webhook",
      "displayName": "Webhook",
      "categoria": "gatilho",
      "descricao": "Recebe requisições HTTP para iniciar o fluxo. Define método e caminho.",
      "obrigatorios": ["httpMethod", "path"],
      "exemplo": { "httpMethod": "POST", "path": "meu-webhook", "responseMode": "onReceived" },
      "precisaCredencial": false
    },
    {
      "type": "n8n-nodes-base.formTrigger",
      "displayName": "n8n Form Trigger",
      "categoria": "gatilho",
      "descricao": "Gera um formulário web que inicia o fluxo ao ser enviado.",
      "obrigatorios": ["formTitle", "formFields"],
      "exemplo": {
        "formTitle": "Meu Formulário",
        "formFields": { "values": [{ "fieldLabel": "Nome", "fieldType": "text", "requiredField": true }] }
      },
      "precisaCredencial": false
    },
    {
      "type": "n8n-nodes-base.gmailTrigger",
      "displayName": "Gmail Trigger",
      "categoria": "gatilho",
