      "exemplo": { "method": "GET", "url": "https://api.exemplo.com/dados", "options": {} },
      "precisaCredencial": false
    },
    {
      "type": "n8n-nodes-base.set",
      "displayName": "Edit Fields (Set)",
      "categoria": "acao",
      "descricao": "Define ou transforma campos dos itens que passam pelo fluxo.",
      "obrigatorios": ["assignments"],
      "exemplo": {
        "assignments": { "assignments": [{ "id": "a1", "name": "campo", "value": "valor", "type": "string" }] },
        "options": {}
      },
      "precisaCredencial": false
    },
    {
      "type": "n8n-nodes-base.if",
      "displayName": "If",
      "categoria": "acao",
      "descricao": "Ramifica o fluxo em duas saídas (true/false) conforme condições.",
      "obrigatorios": ["conditions"],
      "exemplo": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "conditions": [{ "leftValue": "={{ $json.valor }}", "rightValue": 10, "operator": { "type": "number", "operation": "gt" } }],
          "combinator": "and"
        },
        "options": {}
      },
      "precisaCredencial": false
    },
    {
      "type": "n8n-nodes-base.switch",
      "displayName": "Switch",
      "categoria": "acao",
      "descricao": "Ramifica o fluxo em múltiplas saídas conforme regras.",
      "obrigatorios": ["rules"],
      "exemplo": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
                "conditions": [{ "leftValue": "={{ $json.tipo }}", "rightValue": "A", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "outputKey": "A"
            }
          ]
        },
        "options": {}
      },
      "precisaCredencial": false
    },
    {
      "type": "n8n-nodes-base.code",
