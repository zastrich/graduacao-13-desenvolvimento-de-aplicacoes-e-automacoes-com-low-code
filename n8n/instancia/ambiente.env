# Configuração da instância local do n8n (sem segredos — pode ser versionado).
# O N8N_USER_FOLDER NÃO é definido aqui: o launcher força sempre o caminho
# absoluto de n8n/instancia, para garantir que os dados fiquem no projeto.

N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo

# Windows não suporta permissões 0600 nos arquivos de configuração.
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

# Desliga a telemetria de diagnóstico.
N8N_DIAGNOSTICS_ENABLED=false
