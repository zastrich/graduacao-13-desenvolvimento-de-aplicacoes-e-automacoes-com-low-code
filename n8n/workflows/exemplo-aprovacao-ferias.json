      ],
      "parameters": {
        "formTitle": "Aprovação de Férias — Gestor",
        "formDescription": "Analise os dados abaixo e decida.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Resumo",
              "fieldType": "html",
              "html": "=<h2>Aprovação de Férias — Gestor</h2><p><b>Colaborador:</b> {{ $('Calcular Regras').first().json.colaborador.nome }} (matrícula {{ $('Calcular Regras').first().json.matricula }})</p><p><b>Período solicitado:</b> {{ $('Calcular Regras').first().json.inicio }} a {{ $('Calcular Regras').first().json.fim }} ({{ $('Calcular Regras').first().json.dias }} dias)</p><p><b>Saldo de dias:</b> {{ $('Calcular Regras').first().json.saldoDias }}</p><p><b>Gestor responsável:</b> {{ $('Calcular Regras').first().json.colaborador.gestor }}</p><p><b>Avaliação automática:</b> {{ $('Ler Resposta').first().json.motivo }}</p>"
            },
            {
              "fieldLabel": "Decisão",
              "fieldType": "radio",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Aprovar"
                  },
                  {
                    "option": "Reprovar"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Motivo da reprovação",
              "fieldType": "textarea",
              "requiredField": false
            }
          ]
        },
        "options": {}
      }
