    {
      "id": "49a7af40-993c-41bc-bd18-422ef83d466d",
      "name": "Ler Resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        784,
        304
      ],
      "parameters": {
        "jsCode": "// Extrai JSON da resposta da IA, tolerando cercas e texto ao redor.\nconst texto = String($json.text ?? $json.output ?? '');\nlet obj;\ntry {\n  obj = JSON.parse(texto);\n} catch (e) {\n  const cerca = texto.match(/\\`\\`\\`(?:json)?\\s*([\\s\\S]*?)\\`\\`\\`/i);\n  const corpo = cerca ? cerca[1] : texto.slice(texto.indexOf('{'), texto.lastIndexOf('}') + 1);\n  obj = JSON.parse(corpo);\n}\nreturn [{ json: { aprovado: obj.aprovado === true, motivo: obj.motivo || '' } }];"
      }
    },
