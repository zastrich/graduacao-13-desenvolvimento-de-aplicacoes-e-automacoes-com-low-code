# Copie este arquivo para scripts/.env e preencha os valores.
# scripts/.env NÃO é versionado (contém segredos).

# URL base da instância local do n8n.
N8N_URL=http://localhost:5678

# API key criada em Settings -> n8n API na instância local (Task 2).
N8N_API_KEY=

# Token do Header Auth do webhook dry-run do Núcleo (mesmo valor da credencial
# "Header Auth X-Dry-Run-Token" no n8n). Definido na Task 8.
DRY_RUN_TOKEN=

# Chave do Google Gemini (AI Studio). Usada pelo nó Gemini Chat Model (via credencial
# no n8n) e, opcionalmente, por scripts de teste do gerador.
# Modelo validado nesta instância: gemini-3.8-flash (endpoint v1beta). A geração de
# JSON leva ~14s; use timeouts altos e Retry On Fail.
GEMINI_API_KEY=

# Chave da API da OpenAI (platform.openai.com) para o nó OpenAI Chat Model.
OPENAI_API_KEY=

# OAuth Client (Google Cloud Console) para as credenciais Google Drive/Sheets no n8n.
# Tipo "Aplicativo da Web", redirect URI: http://localhost:5678/rest/oauth2-credential/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=